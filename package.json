{
  "name": "neon-dungeon",
  "version": "6.0.2-wip",
  "description": "NEON DUNGEON — neon roguelite. Canvas-based, no runtime deps.",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:engine": "node scripts/check-engine-purity.js",
    "check": "npm run lint && npm run typecheck && npm run check:engine && npm test"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "typescript": "^5.9.3"
  }
}
